# =============================================================================
# linkedin-auto-apply — configuration template
# =============================================================================
# Copy this file to `.env` in the repository root and fill in the three
# required values below. Every other setting already has a safe default, so an
# .env containing only those three is a valid configuration.
#
#     cp .env.example .env
#
# `scripts/setup.sh` (or `scripts/setup.ps1` on Windows) does the copy for you
# and generates SECRET_KEY and ENCRYPTION_KEY. Names are case-insensitive; the
# values are parsed by `Settings` in backend/app/config.py.
# =============================================================================


# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Signs the JWTs issued to your browser. Generate a fresh random value:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving it empty generates a new random key on every process start, which
# invalidates all logged-in sessions each time the server restarts.
SECRET_KEY=

# Derives the key that encrypts sensitive data at rest — currently the LinkedIn
# session cookies. Generate it the same way:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# WARNING: changing this value makes everything already encrypted permanently
# unreadable. You will have to log in to LinkedIn again in the browser.
ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Display name used in logs and in the API metadata.
APP_NAME=LinkedIn Auto Apply

# Free-form label for the deployment: development | production.
ENVIRONMENT=development

# Verbose logging plus SQLAlchemy statement echo. Keep false outside debugging.
DEBUG=false


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# JWT signing algorithm. Change only if you know why you need to.
JWT_ALGORITHM=HS256

# How long an access token stays valid, in minutes (default: 12 hours).
ACCESS_TOKEN_TTL_MINUTES=720


# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
#
# Which provider scores jobs, writes cover letters and drafts screening answers.
# Leave empty and the app decides: the paid Anthropic path when
# ANTHROPIC_API_KEY is set, otherwise the offline provider — so a fresh clone
# runs end to end without you signing up for anything.
#
#   ollama      local model, no key, no quota, nothing leaves the machine
#   groq        free tier, needs AI_API_KEY  (console.groq.com/keys)
#   gemini      free tier, needs AI_API_KEY  (aistudio.google.com/apikey)
#   openrouter  free `:free` models, needs AI_API_KEY  (openrouter.ai/keys)
#   cerebras    free tier, needs AI_API_KEY  (cloud.cerebras.ai)
#   llamacpp    a local llama.cpp server, no key
#   stub        offline, deterministic; labels its own output as a placeholder
#   anthropic   Claude, needs ANTHROPIC_API_KEY
#
# Your resume and your screening answers are personal data. `ollama` is the
# recommendation for that reason: a local model sends none of it anywhere. The
# hosted free tiers are a convenience — read their terms, including whether your
# prompts are used for training, before you send a resume through one.
#
# For ollama:  install from https://ollama.com, then `ollama pull qwen2.5:7b-instruct`
AI_PROVIDER=

# API key for the OpenAI-compatible providers above. Not used by ollama,
# llamacpp or stub, and not used by anthropic (which reads ANTHROPIC_API_KEY).
AI_API_KEY=

# Override the provider's endpoint and model. Both default to values that work
# on that provider's free tier, so you usually only set AI_PROVIDER.
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=qwen2.5:14b-instruct
AI_BASE_URL=
AI_MODEL=

# Anthropic API key, for AI_PROVIDER=anthropic. Get one at
# https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Claude model used when the provider is anthropic.
ANTHROPIC_MODEL=claude-opus-5

# Effort level for bulk job scoring, where cost matters more than depth.
# One of: low | medium | high | xhigh | max. Cover letters always use "high".
# Anthropic-only; the other providers map it onto sampling temperature.
SCORING_EFFORT=low


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Leave empty for SQLite at backend/data/app.db (recommended for self-hosting).
# For PostgreSQL, install the extra (`pip install -e ".[postgres]"`) and use an
# async driver URL:
#     DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/linkedin
DATABASE_URL=


# -----------------------------------------------------------------------------
# Automation guardrails
# -----------------------------------------------------------------------------

# Run Chromium without a visible window. Keep false: you log in to LinkedIn
# manually in that window, and you want to see what the automation is doing.
HEADLESS=false

# Drive a fake job portal bundled with the app instead of the live site, so the
# whole flow can be tried out without a LinkedIn account and without an
# application going anywhere real. Off by default. `make demo` turns it on for
# you along with the offline AI provider; there is no reason to set it here
# unless you want a permanently sandboxed install.
DEMO_PORTAL=false

# Concurrent browser sessions. More than one looks like bot traffic.
MAX_CONCURRENT_SESSIONS=1

# Default caps applied to new accounts; each user can adjust them in Settings.
DEFAULT_DAILY_CAP=15
DEFAULT_MIN_SCORE=70

# Randomized pause between individual page actions, in seconds: "min,max".
DEFAULT_ACTION_DELAY_RANGE=2.5,7.0

# Randomized pause between two applications, in seconds: "min,max".
DEFAULT_APPLY_DELAY_RANGE=45.0,120.0

# Hours of the day during which runs are allowed: "start,end" (24-hour clock).
DEFAULT_WORKING_HOURS=8,20

# Hard guarantee that nothing is ever submitted without an explicit, separate
# confirmation from you. Do not turn this off.
ASSISTED_MODE_ONLY=true


# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

# Browser origins allowed to call the API, comma-separated. Add the Docker port
# (http://localhost:8000) when you serve the built frontend from the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request throttling, in slowapi syntax ("<count>/<period>").
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute


# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------

# Where the database, browser profiles, resumes and screenshots are stored.
# Defaults to backend/data. In Docker this is the mounted volume, so leave the
# container value alone unless you also change docker-compose.yml.
# DATA_DIR=backend/data
